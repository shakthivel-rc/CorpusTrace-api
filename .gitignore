# Docker
# A local-only override, by convention. Everything else Docker-related — the Dockerfile,
# docker-compose.yml and .dockerignore — is committed on purpose: they are how someone
# runs this from a clone.
docker-compose.override.yml

# .dockerignore was ignored here. That is actively dangerous, not merely untidy: without it
# in a fresh clone, `COPY . .` bakes the developer's .env — real SECRET_KEY, real database
# credentials — into the image, and `docker history` will show it to anyone who pulls.



#testing purpose
myenv/
chroma_db/
uploads/
chroma_db/chroma.sqlite3
chroma_db/chroma.sqlite3

