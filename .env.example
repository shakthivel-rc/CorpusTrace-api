# CorpusTrace API — copy to .env and fill in. Never commit a filled-in copy.
#
# load_dotenv() reads the CURRENT WORKING DIRECTORY, so always start the backend from
# CorpusTrace-api/. Settings are lru_cache'd and read at *import* time: a missing required
# value raises RuntimeError before uvicorn starts, and changing the environment after
# first access has no effect.

# --- Required. The process will not start without these two. ---------------------
# Also read directly by alembic/env.py.
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/corpustrace

# WARNING: this one value does three jobs — it signs JWTs, it is the Fernet key in
# utils/token.py (verify/reset links), and it is the FALLBACK key for LLM provider
# credentials when LLM_CREDENTIAL_ENCRYPTION_KEY is unset. Rotating it therefore
# invalidates every outstanding reset link AND makes every stored provider credential
# permanently undecryptable. Set LLM_CREDENTIAL_ENCRYPTION_KEY explicitly to decouple.
# Must be a valid urlsafe-base64 32-byte Fernet key.
SECRET_KEY=

# --- Application ------------------------------------------------------------------
APP_NAME=CorpusTrace API
# "prod" activates the guard that rejects "*" in CORS_ORIGINS.
ENVIRONMENT=development
LOG_LEVEL=INFO

# CSV. NOTE: the default (http://localhost:5173) does NOT match the dev server, which
# runs on port 3000.
CORS_ORIGINS=http://localhost:3000

# --- Auth -------------------------------------------------------------------------
ALGORITHM=HS256
# HOURS, despite the unit-free name.
JWT_EXPIRY_VALUE=1
REFRESH_TOKEN_EXPIRY_DAYS=30
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12

# --- RAG --------------------------------------------------------------------------
RAG_UPLOAD_DIR=uploads/rag

# --- LLM providers ----------------------------------------------------------------
# Strongly recommended: set this so provider credentials survive a SECRET_KEY rotation.
# If unset, a Fernet key is derived from SECRET_KEY via SHA-256 + urlsafe-b64.
LLM_CREDENTIAL_ENCRYPTION_KEY=
LLM_MODEL_CACHE_TTL_HOURS=24
LLM_REQUEST_TIMEOUT_SECONDS=45

# Where Ollama is, used when no per-user base URL has been saved. Ollama is the free,
# keyless, local option for both chat and embeddings — including Google's EmbeddingGemma,
# which Ollama serves without the Hugging Face licence gate.
#
# Leave this commented out. Both ways of running the project already default correctly:
# core/config.py uses http://localhost:11434, which is right for a native API reaching
# Ollama on the host, and docker-compose.yml uses http://ollama:11434, which is right
# inside a container where localhost is the container itself.
#
# That only holds while the key is UNSET. `${OLLAMA_BASE_URL:-http://ollama:11434}` is a
# default, not an override, so a .env that names this line hands the containerised API the
# host's answer and every LLM call fails with "[Errno 111] Connection refused" — reported
# against the model, not against the address it could not reach. (The entrypoint now
# repairs that case, but a value nobody had to write cannot be wrong in the first place.)
#
# Set it only to reach an Ollama somewhere else — another machine, or a non-default port.
#   make embeddings     starts it and pulls the model
#OLLAMA_BASE_URL=http://localhost:11434

# --- High-Precision RAG (retrieval mode "high_precision") -----------------------------
# Every variable below is optional and every default is the shipped behaviour, so this whole
# section can stay commented out. They tune ONE retrieval mode; none of them affects
# Contextual Hybrid, RAG-Fusion, GraphRAG, Corrective, Multi-Modal or Agentic RAG.
#
# Anything unparseable is clamped to a valid value rather than raising — a typo in a
# retrieval weight must not stop the API answering questions.

# Master switch, and the size of the two ends of the pipeline. CANDIDATE_K is the pool that
# reaches the reranker (50-100 is the useful range); FINAL_K is what the mode returns.
# PRECISION_RAG_ENABLED=true
# PRECISION_RAG_CANDIDATE_K=100
# PRECISION_RAG_FINAL_K=10

# Which retrievers run. DENSE is inert unless the documents were uploaded with an embedding
# model, so leaving it on costs nothing on a lexical-only knowledge base.
# PRECISION_RAG_BM25=true
# PRECISION_RAG_DENSE=true
# PRECISION_RAG_BM25_K1=1.2
# PRECISION_RAG_BM25_B=0.75

# How the signals are combined. These weight MIN-MAX NORMALISED per-signal scores, which is
# what makes a weighted sum meaningful across a BM25 score and a cosine.
# PRECISION_RAG_DENSE_WEIGHT=1.0
# PRECISION_RAG_BM25_WEIGHT=1.0
# PRECISION_RAG_METADATA_WEIGHT=0.35
# PRECISION_RAG_KEYWORD_WEIGHT=0.5

# Query understanding. Expansion is additive and weighted: a word the user typed always
# carries 1.0, so an expansion can raise a passage but never outrank what was actually asked.
# PRECISION_RAG_NORMALIZATION=true
# PRECISION_RAG_QUERY_EXPANSION=true
# PRECISION_RAG_EXPANSION_MAX_TERMS=12
# PRECISION_RAG_EXPANSION_WEIGHT=0.45
# PRECISION_RAG_PRF=true
# PRECISION_RAG_PRF_DOCUMENTS=5
# PRECISION_RAG_PRF_TERMS=6
# PRECISION_RAG_PRF_WEIGHT=0.25
# PRECISION_RAG_ENTITY_EXTRACTION=true

# A JSON object of {"term": ["alias", ...]} — your domain's synonyms, abbreviations and
# entity aliases. This is where domain vocabulary belongs; the engine ships only
# general-purpose equivalences, because a wrong expansion looks exactly like a retrieval bug.
# A missing or malformed file is logged and ignored, never fatal.
# PRECISION_RAG_DICTIONARY_PATH=

# Metadata filtering. A filter is applied only if it leaves at least MIN_SURVIVORS
# candidates: a version or category inferred from the question is a guess, and a guess that
# empties the pool has turned a ranking problem into a refusal.
# PRECISION_RAG_METADATA_FILTERING=true
# PRECISION_RAG_FILTER_MIN_SURVIVORS=12

# Cross-encoder reranking. BACKEND is one of: lexical (default, pure Python, no model and no
# network), http (a local reranking service), none.
#
# The `http` backend posts {query, texts/documents} and reads a list of {index, score} or
# {"results":[{index, relevance_score}]} — the shape text-embeddings-inference, Infinity,
# Xinference and the BGE-reranker servers all speak. It is a RERANKER, not a generator: it
# returns one relevance score per pair and cannot produce text. Example endpoint for
# `docker run ghcr.io/huggingface/text-embeddings-inference --model-id BAAI/bge-reranker-base`:
#   PRECISION_RAG_RERANKER_BACKEND=http
#   PRECISION_RAG_RERANKER_ENDPOINT=http://localhost:8080/rerank
# An unreachable endpoint falls back to the lexical scorer and records the reason; it never
# costs the answer.
#
# RERANKER_WEIGHT is how much the reranker may move the retrieval ranking: 1.0 lets it decide
# outright, 0.0 ignores it. Below 1.0 by default so a badly-configured reranker degrades the
# ordering instead of replacing it.
# PRECISION_RAG_RERANKER=true
# PRECISION_RAG_RERANKER_BACKEND=lexical
# PRECISION_RAG_RERANKER_TOP_K=20
# PRECISION_RAG_RERANKER_MODEL=BAAI/bge-reranker-base
# PRECISION_RAG_RERANKER_ENDPOINT=
# PRECISION_RAG_RERANKER_TIMEOUT_SECONDS=10
# PRECISION_RAG_RERANKER_WEIGHT=0.75

# Negative relevance signals. Comma-separated, and EMPTY by default on purpose: a shipped
# list of "bad" words would be an unauditable opinion about your documents applied to every
# question anyone asks. The penalty scales the score (it never subtracts), so it cannot
# invert an ordering or push a score below zero.
# PRECISION_RAG_NEGATIVE_SIGNALS=true
# PRECISION_RAG_NEGATIVE_TERMS=
# PRECISION_RAG_NEGATIVE_PENALTY=0.35

# Diversity. Deduplication matters here because the chunker OVERLAPS by design, so adjacent
# chunks genuinely share text; MMR then trades a little relevance for complementary evidence.
# Raise MMR_LAMBDA toward 1.0 for pure relevance.
# PRECISION_RAG_DEDUP=true
# PRECISION_RAG_DEDUP_THRESHOLD=0.90
# PRECISION_RAG_MMR=true
# PRECISION_RAG_MMR_LAMBDA=0.7

# Parent-chunk recovery: how many consecutive sibling chunks form one parent window, and how
# much surrounding text a result may carry. Nothing is re-chunked — the existing chunks are
# the children — so this changes what the mode RETURNS, never what is indexed.
# PRECISION_RAG_PARENT_CHILD=true
# PRECISION_RAG_PARENT_GROUP_SIZE=3
# PRECISION_RAG_PARENT_MAX_CHARS=2400

# Observability. One structured log line per question on the `corpustrace.rag.precision`
# logger: ids, counts, scores and the QUERY's own terms. Never passage text — the log is what
# gets pasted into a bug report.
# PRECISION_RAG_TRACE=true
# PRECISION_RAG_TRACE_MAX_CANDIDATES=25

# --- Email ------------------------------------------------------------------------
# Read with a bare os.getenv and interpolated into invite/reset links. If unset the
# literal string "None" ends up in the emailed URL.
APP_BASE_URL=http://localhost:3000

# Outside the Settings dataclass and unvalidated at startup, so a typo surfaces only
# when an email is actually sent. Despite the module being named aws_ses.py this uses
# stdlib smtplib and NOT boto3. There is no socket timeout: an unresponsive relay
# hangs the request.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CorpusTrace
SMTP_USE_TLS=true

# --- Setup: ports and compose -------------------------------------------------------
# Written by scripts/bootstrap.sh, which checks each one is actually free first and moves
# it if it is not. Everything that names a port — APP_BASE_URL and CORS_ORIGINS above,
# the published ports in docker-compose.yml, the dev servers `make dev` starts — reads
# these, so changing one here is enough.
#
# MYSQL_PORT and API_PORT are published on 127.0.0.1 only; APP_PORT is the one that is
# reachable from the network.
MYSQL_PORT=3307
API_PORT=8000
APP_PORT=8080
# Only published when the optional `embeddings` compose profile is running.
OLLAMA_PORT=11434
# The Vite dev server (`make dev` / `npm run dev`). Only used in a native setup.
APP_DEV_PORT=3000

# The compose project name: the prefix on every container, network and volume. Leave it
# unset unless setup wrote one — it does that only to stand a second stack up beside a
# database volume whose password this .env no longer has.
# COMPOSE_PROJECT_NAME=corpustrace

# The database image. A backstop for an architecture with no image for the default tag,
# not a general knob — the schema and migrations are written against MySQL 8.
# MYSQL_IMAGE=mysql:8.0

# --- Seeder only ------------------------------------------------------------------
# Required only by `python -m seeders.user_seeder`, which raises without it.
# Prefer passing it inline for one-off runs rather than persisting it here.
SUPERADMIN_PASSWORD=

# The seeded accounts' sign-in addresses. Default to superadmin@corpustrace.local and
# customer@corpustrace.local — .local is reserved and unroutable, so a default install cannot
# be mistaken for a real mailbox.
#
# The seeder matches on email, so changing these does NOT rename an account that already
# exists; it creates another one. If you seeded before these became configurable, set
# SUPERADMIN_EMAIL to the address already in your database.
SUPERADMIN_EMAIL=
SEED_CUSTOMER_EMAIL=
