# CorpusTrace API — copy to .env and fill in. Never commit a filled-in copy.
#
# load_dotenv() reads the CURRENT WORKING DIRECTORY, so always start the backend from
# CorpusTrace-api/. Settings are lru_cache'd and read at *import* time: a missing required
# value raises RuntimeError before uvicorn starts, and changing the environment after
# first access has no effect.

# --- Required. The process will not start without these two. ---------------------
# Also read directly by alembic/env.py.
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/corpustrace

# WARNING: this one value does three jobs — it signs JWTs, it is the Fernet key in
# utils/token.py (verify/reset links), and it is the FALLBACK key for LLM provider
# credentials when LLM_CREDENTIAL_ENCRYPTION_KEY is unset. Rotating it therefore
# invalidates every outstanding reset link AND makes every stored provider credential
# permanently undecryptable. Set LLM_CREDENTIAL_ENCRYPTION_KEY explicitly to decouple.
# Must be a valid urlsafe-base64 32-byte Fernet key.
SECRET_KEY=

# --- Application ------------------------------------------------------------------
APP_NAME=CorpusTrace API
# "prod" activates the guard that rejects "*" in CORS_ORIGINS.
ENVIRONMENT=development
LOG_LEVEL=INFO

# CSV. NOTE: the default (http://localhost:5173) does NOT match the dev server, which
# runs on port 3000.
CORS_ORIGINS=http://localhost:3000

# --- Auth -------------------------------------------------------------------------
ALGORITHM=HS256
# HOURS, despite the unit-free name.
JWT_EXPIRY_VALUE=1
REFRESH_TOKEN_EXPIRY_DAYS=30
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12

# --- RAG --------------------------------------------------------------------------
RAG_UPLOAD_DIR=uploads/rag

# --- LLM providers ----------------------------------------------------------------
# Strongly recommended: set this so provider credentials survive a SECRET_KEY rotation.
# If unset, a Fernet key is derived from SECRET_KEY via SHA-256 + urlsafe-b64.
LLM_CREDENTIAL_ENCRYPTION_KEY=
LLM_MODEL_CACHE_TTL_HOURS=24
LLM_REQUEST_TIMEOUT_SECONDS=45

# Where Ollama is, used when no per-user base URL has been saved. Ollama is the free,
# keyless, local option for both chat and embeddings — including Google's EmbeddingGemma,
# which Ollama serves without the Hugging Face licence gate.
#
# Leave this commented out. Both ways of running the project already default correctly:
# core/config.py uses http://localhost:11434, which is right for a native API reaching
# Ollama on the host, and docker-compose.yml uses http://ollama:11434, which is right
# inside a container where localhost is the container itself.
#
# That only holds while the key is UNSET. `${OLLAMA_BASE_URL:-http://ollama:11434}` is a
# default, not an override, so a .env that names this line hands the containerised API the
# host's answer and every LLM call fails with "[Errno 111] Connection refused" — reported
# against the model, not against the address it could not reach. (The entrypoint now
# repairs that case, but a value nobody had to write cannot be wrong in the first place.)
#
# Set it only to reach an Ollama somewhere else — another machine, or a non-default port.
#   make embeddings     starts it and pulls the model
#OLLAMA_BASE_URL=http://localhost:11434

# --- Email ------------------------------------------------------------------------
# Read with a bare os.getenv and interpolated into invite/reset links. If unset the
# literal string "None" ends up in the emailed URL.
APP_BASE_URL=http://localhost:3000

# Outside the Settings dataclass and unvalidated at startup, so a typo surfaces only
# when an email is actually sent. Despite the module being named aws_ses.py this uses
# stdlib smtplib and NOT boto3. There is no socket timeout: an unresponsive relay
# hangs the request.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CorpusTrace
SMTP_USE_TLS=true

# --- Setup: ports and compose -------------------------------------------------------
# Written by scripts/bootstrap.sh, which checks each one is actually free first and moves
# it if it is not. Everything that names a port — APP_BASE_URL and CORS_ORIGINS above,
# the published ports in docker-compose.yml, the dev servers `make dev` starts — reads
# these, so changing one here is enough.
#
# MYSQL_PORT and API_PORT are published on 127.0.0.1 only; APP_PORT is the one that is
# reachable from the network.
MYSQL_PORT=3307
API_PORT=8000
APP_PORT=8080
# Only published when the optional `embeddings` compose profile is running.
OLLAMA_PORT=11434
# The Vite dev server (`make dev` / `npm run dev`). Only used in a native setup.
APP_DEV_PORT=3000

# The compose project name: the prefix on every container, network and volume. Leave it
# unset unless setup wrote one — it does that only to stand a second stack up beside a
# database volume whose password this .env no longer has.
# COMPOSE_PROJECT_NAME=corpustrace

# The database image. A backstop for an architecture with no image for the default tag,
# not a general knob — the schema and migrations are written against MySQL 8.
# MYSQL_IMAGE=mysql:8.0

# --- Seeder only ------------------------------------------------------------------
# Required only by `python -m seeders.user_seeder`, which raises without it.
# Prefer passing it inline for one-off runs rather than persisting it here.
SUPERADMIN_PASSWORD=

# The seeded accounts' sign-in addresses. Default to superadmin@corpustrace.local and
# customer@corpustrace.local — .local is reserved and unroutable, so a default install cannot
# be mistaken for a real mailbox.
#
# The seeder matches on email, so changing these does NOT rename an account that already
# exists; it creates another one. If you seeded before these became configurable, set
# SUPERADMIN_EMAIL to the address already in your database.
SUPERADMIN_EMAIL=
SEED_CUSTOMER_EMAIL=
