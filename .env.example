# nexarag-api — copy to .env and fill in. Never commit a filled-in copy.
#
# load_dotenv() reads the CURRENT WORKING DIRECTORY, so always start the backend from
# nexarag-api/. Settings are lru_cache'd and read at *import* time: a missing required
# value raises RuntimeError before uvicorn starts, and changing the environment after
# first access has no effect.

# --- Required. The process will not start without these two. ---------------------
# Also read directly by alembic/env.py.
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/nexarag

# WARNING: this one value does three jobs — it signs JWTs, it is the Fernet key in
# utils/token.py (verify/reset links), and it is the FALLBACK key for LLM provider
# credentials when LLM_CREDENTIAL_ENCRYPTION_KEY is unset. Rotating it therefore
# invalidates every outstanding reset link AND makes every stored provider credential
# permanently undecryptable. Set LLM_CREDENTIAL_ENCRYPTION_KEY explicitly to decouple.
# Must be a valid urlsafe-base64 32-byte Fernet key.
SECRET_KEY=

# --- Application ------------------------------------------------------------------
APP_NAME=NexaRAG API
# "prod" activates the guard that rejects "*" in CORS_ORIGINS.
ENVIRONMENT=development
LOG_LEVEL=INFO

# CSV. NOTE: the default (http://localhost:5173) does NOT match the dev server, which
# runs on port 3000.
CORS_ORIGINS=http://localhost:3000

# --- Auth -------------------------------------------------------------------------
ALGORITHM=HS256
# HOURS, despite the unit-free name.
JWT_EXPIRY_VALUE=1
REFRESH_TOKEN_EXPIRY_DAYS=30
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12

# --- RAG --------------------------------------------------------------------------
RAG_UPLOAD_DIR=uploads/rag

# --- LLM providers ----------------------------------------------------------------
# Strongly recommended: set this so provider credentials survive a SECRET_KEY rotation.
# If unset, a Fernet key is derived from SECRET_KEY via SHA-256 + urlsafe-b64.
LLM_CREDENTIAL_ENCRYPTION_KEY=
LLM_MODEL_CACHE_TTL_HOURS=24
LLM_REQUEST_TIMEOUT_SECONDS=45

# --- Email ------------------------------------------------------------------------
# Read with a bare os.getenv and interpolated into invite/reset links. If unset the
# literal string "None" ends up in the emailed URL.
APP_BASE_URL=http://localhost:3000

# Outside the Settings dataclass and unvalidated at startup, so a typo surfaces only
# when an email is actually sent. Despite the module being named aws_ses.py this uses
# stdlib smtplib and NOT boto3. There is no socket timeout: an unresponsive relay
# hangs the request.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=NexaRAG
SMTP_USE_TLS=true

# --- Seeder only ------------------------------------------------------------------
# Required only by `python -m seeders.user_seeder`, which raises without it.
# Prefer passing it inline for one-off runs rather than persisting it here.
SUPERADMIN_PASSWORD=

# The seeded accounts' sign-in addresses. Default to superadmin@nexarag.local and
# customer@nexarag.local — .local is reserved and unroutable, so a default install cannot
# be mistaken for a real mailbox.
#
# The seeder matches on email, so changing these does NOT rename an account that already
# exists; it creates another one. If you seeded before these became configurable, set
# SUPERADMIN_EMAIL to the address already in your database.
SUPERADMIN_EMAIL=
SEED_CUSTOMER_EMAIL=
